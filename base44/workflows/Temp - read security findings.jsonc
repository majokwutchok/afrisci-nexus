{
  "name": "Temp - read security findings",
  "description": "Temporary: reads the latest security scan findings. Safe to delete.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 1 1 *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "read_findings": {
          "call": "app_security_scan",
          "then": "end",
          "with": {
            "action": "results",
            "max_findings": 100
          },
          "x-base44": {
            "title": "Read security findings"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "read_security_findings",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}