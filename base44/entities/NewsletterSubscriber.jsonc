{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Subscriber email address"
    },
    "name": {
      "type": "string",
      "description": "Subscriber name (optional)"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Research interest areas"
    },
    "is_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Email confirmed via confirmation link"
    },
    "confirmation_token": {
      "type": "string",
      "description": "Token for email confirmation"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Subscription status"
    },
    "last_newsletter_sent_date": {
      "type": "string",
      "format": "date",
      "description": "Last newsletter delivery date"
    },
    "source": {
      "type": "string",
      "enum": [
        "sidebar",
        "page",
        "form"
      ],
      "default": "sidebar",
      "description": "Where subscription originated"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this subscriber"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": [
              "admin",
              "editor"
            ]
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": [
              "admin",
              "editor"
            ]
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": [
              "admin",
              "editor"
            ]
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    }
  }
}