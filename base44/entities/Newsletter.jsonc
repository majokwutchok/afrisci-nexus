{
  "name": "Newsletter",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Newsletter issue title"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "featured_articles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "manuscript_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "string"
          },
          "abstract_preview": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Featured articles in this newsletter"
    },
    "editorial_message": {
      "type": "string",
      "description": "Opening message from editorial team"
    },
    "html_content": {
      "type": "string",
      "description": "Full HTML email template"
    },
    "send_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled send date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sending",
        "sent",
        "failed"
      ],
      "default": "draft",
      "description": "Newsletter status"
    },
    "recipient_count": {
      "type": "number",
      "default": 0,
      "description": "Number of recipients sent to"
    },
    "open_count": {
      "type": "number",
      "default": 0,
      "description": "Number of opens (if tracking enabled)"
    },
    "click_count": {
      "type": "number",
      "default": 0,
      "description": "Number of clicks (if tracking enabled)"
    },
    "created_by": {
      "type": "string",
      "description": "User email who created newsletter"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional notes about this newsletter issue"
    },
    "issue_number": {
      "type": "number",
      "description": "Sequential issue number of AfriSci Newsletter"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Cover date of the issue"
    },
    "journal_id": {
      "type": "string",
      "description": "Optional: limit this edition to one journal"
    },
    "journal_title": {
      "type": "string"
    },
    "headline": {
      "type": "string",
      "description": "Issue headline shown under the masthead"
    },
    "sections": {
      "type": "object",
      "description": "Structured issue content: article lists, spotlight, ideas, call to action",
      "additionalProperties": true
    },
    "articles": {
      "type": "object",
      "description": "Snapshot of article display data keyed by manuscript id",
      "additionalProperties": true
    },
    "audience": {
      "type": "object",
      "description": "Who receives this issue: subscribers, authors, manual emails",
      "properties": {
        "subscribers": {
          "type": "boolean"
        },
        "authors": {
          "type": "boolean"
        },
        "manual": {
          "type": "string"
        }
      }
    },
    "recipient_list": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Deduplicated recipients captured when sending started"
    },
    "sent_index": {
      "type": "number",
      "default": 0
    },
    "sent_count": {
      "type": "number",
      "default": 0
    },
    "failed_count": {
      "type": "number",
      "default": 0
    },
    "last_error": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "subject",
    "featured_articles"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
