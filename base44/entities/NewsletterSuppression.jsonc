{
  "name": "NewsletterSuppression",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Address that must not receive AfriSci Newsletter"
    },
    "reason": {
      "type": "string",
      "enum": [
        "unsubscribed",
        "bounced",
        "complaint",
        "manual"
      ],
      "default": "unsubscribed"
    },
    "newsletter_id": {
      "type": "string",
      "description": "Issue the unsubscribe came from, if any"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
