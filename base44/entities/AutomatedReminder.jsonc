{
  "name": "AutomatedReminder",
  "type": "object",
  "properties": {
    "manuscript_id": {
      "type": "string",
      "description": "ID of the manuscript"
    },
    "reviewer_id": {
      "type": "string",
      "description": "ID of the reviewer"
    },
    "reminder_type": {
      "type": "string",
      "enum": [
        "initial_invitation",
        "first_reminder",
        "second_reminder",
        "final_reminder",
        "editor_alert"
      ],
      "description": "Type of reminder"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "When the reminder should be sent"
    },
    "sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether reminder has been sent"
    },
    "sent_date": {
      "type": "string",
      "format": "date",
      "description": "When reminder was actually sent"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or context for this reminder"
    }
  },
  "required": [
    "manuscript_id",
    "reviewer_id",
    "reminder_type",
    "scheduled_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": [
          "admin",
          "editor"
        ]
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": [
              "admin",
              "editor"
            ]
          }
        },
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "data.manuscript_id": {
            "$in": "{{user.author_manuscripts_ids}}"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": [
          "admin",
          "editor"
        ]
      }
    },
    "delete": {
      "user_condition": {
        "role": [
          "admin",
          "editor"
        ]
      }
    }
  }
}