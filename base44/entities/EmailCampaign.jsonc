{
  "name": "EmailCampaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Campaign name"
    },
    "template_name": {
      "type": "string",
      "description": "Name of the template used"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "body_html": {
      "type": "string",
      "description": "HTML email body"
    },
    "country": {
      "type": "string",
      "description": "Target country"
    },
    "institution_type": {
      "type": "string",
      "description": "Target institution type filter"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sending",
        "sent",
        "paused"
      ],
      "default": "draft"
    },
    "scheduled_at": {
      "type": "string",
      "description": "ISO datetime to send"
    },
    "sent_at": {
      "type": "string",
      "description": "ISO datetime when sending started"
    },
    "total_recipients": {
      "type": "number",
      "default": 0
    },
    "sent_count": {
      "type": "number",
      "default": 0
    },
    "open_count": {
      "type": "number",
      "default": 0
    },
    "click_count": {
      "type": "number",
      "default": 0
    },
    "error_count": {
      "type": "number",
      "default": 0
    },
    "from_name": {
      "type": "string",
      "default": "AfriSci Nexus Editorial Team"
    }
  },
  "required": [
    "name",
    "subject",
    "body_html"
  ]
}