{
  "name": "ProspectEmail",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Validated email address"
    },
    "contact_name": {
      "type": "string",
      "description": "Name of the contact person"
    },
    "institution": {
      "type": "string",
      "description": "Name of the institution/organization"
    },
    "institution_type": {
      "type": "string",
      "enum": [
        "university",
        "hospital",
        "school",
        "research_institute",
        "ngo",
        "government",
        "professional_association",
        "other"
      ],
      "description": "Type of institution"
    },
    "country": {
      "type": "string",
      "description": "African country name"
    },
    "department": {
      "type": "string",
      "description": "Department or faculty"
    },
    "source_url": {
      "type": "string",
      "description": "Source URL where email was found"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL of the contact"
    },
    "linkedin_headline": {
      "type": "string",
      "description": "LinkedIn headline / job title"
    },
    "linkedin_connections": {
      "type": "string",
      "description": "Connection count tier e.g. 500+"
    },
    "linkedin_verified_at": {
      "type": "string",
      "description": "ISO timestamp when LinkedIn was linked"
    },
    "google_scholar_url": {
      "type": "string",
      "description": "Google Scholar profile URL"
    },
    "researchgate_url": {
      "type": "string",
      "description": "ResearchGate profile URL"
    },
    "campaign_status": {
      "type": "string",
      "enum": [
        "new",
        "emailed",
        "responded",
        "unsubscribed"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string"
    },
    "lead_score": {
      "type": "number",
      "default": 0,
      "description": "Engagement score: +10 per open, +25 per click, +50 if responded"
    },
    "engagement_level": {
      "type": "string",
      "enum": [
        "cold",
        "warm",
        "hot"
      ],
      "default": "cold",
      "description": "Derived engagement tier based on lead_score"
    },
    "email_open_count": {
      "type": "number",
      "default": 0,
      "description": "Total number of email opens tracked"
    },
    "email_click_count": {
      "type": "number",
      "default": 0,
      "description": "Total number of email link clicks tracked"
    },
    "last_opened_at": {
      "type": "string",
      "description": "ISO timestamp of last email open"
    },
    "last_clicked_at": {
      "type": "string",
      "description": "ISO timestamp of last email link click"
    },
    "follow_up_sent_at": {
      "type": "string",
      "description": "ISO timestamp when follow-up email was sent"
    },
    "follow_up_count": {
      "type": "number",
      "default": 0,
      "description": "Number of follow-up emails sent"
    }
  },
  "required": [
    "email",
    "country"
  ]
}