{
  "name": "WaiverPool",
  "type": "object",
  "properties": {
    "funder_organization_id": {
      "type": "string",
      "description": "Organization ID of the funder backing this pool"
    },
    "funder_name": {
      "type": "string",
      "description": "Funder display name"
    },
    "name": {
      "type": "string",
      "description": "Pool / collection name"
    },
    "total_slots": {
      "type": "number",
      "default": 0,
      "description": "Prepaid publishing slots purchased"
    },
    "slots_used": {
      "type": "number",
      "default": 0,
      "description": "Slots drawn down"
    },
    "price_per_slot": {
      "type": "number",
      "default": 0,
      "description": "Amount the funder paid per slot"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "eligibility_countries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Eligible author countries (empty = all)"
    },
    "eligibility_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Eligible research topics/keywords"
    },
    "grant_id_prefix": {
      "type": "string",
      "description": "Optional grant ID prefix for eligibility"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "exhausted",
        "closed"
      ],
      "default": "active"
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "funder_name",
    "total_slots"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.funder_organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}