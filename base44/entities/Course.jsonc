{
  "name": "Course",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Course title"
    },
    "course_code": {
      "type": "string",
      "description": "System-generated unique course ID"
    },
    "subtitle": {
      "type": "string",
      "description": "Short marketing subtitle"
    },
    "category": {
      "type": "string",
      "enum": [
        "research_methods",
        "grant_writing",
        "publication_ethics",
        "ai_ethics",
        "technical_writing",
        "peer_review",
        "data_management",
        "project_management"
      ]
    },
    "description": {
      "type": "string",
      "description": "Full course description"
    },
    "instructor": {
      "type": "string"
    },
    "duration_hours": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "string",
      "enum": [
        "foundational",
        "intermediate",
        "advanced"
      ],
      "default": "intermediate"
    },
    "format": {
      "type": "string",
      "enum": [
        "self_paced",
        "live_webinar",
        "cohort"
      ],
      "default": "self_paced"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "cover_image_url": {
      "type": "string"
    },
    "syllabus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content": {
            "type": "string",
            "description": "In-depth teaching content for the module"
          },
          "duration_minutes": {
            "type": "number",
            "default": 0
          }
        }
      },
      "default": []
    },
    "quiz": {
      "type": "array",
      "description": "Final assessment questions (15 per course)",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "correct_index": {
            "type": "number"
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "options",
          "correct_index"
        ]
      },
      "default": []
    },
    "passing_score": {
      "type": "number",
      "default": 12,
      "description": "Correct answers required to pass the quiz (of 15)"
    },
    "learning_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "course_code",
    "category",
    "price"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}