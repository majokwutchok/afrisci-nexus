{
  "name": "Payment",
  "type": "object",
  "properties": {
    "manuscript_id": {
      "type": "string",
      "description": "ID of the manuscript being paid for"
    },
    "journal_id": {
      "type": "string",
      "description": "ID of the journal"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "submission_fee",
        "publication_fee",
        "expedited_review"
      ],
      "description": "Type of payment"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount in USD"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Payment currency"
    },
    "local_amount": {
      "type": "number",
      "description": "Amount in local currency"
    },
    "local_currency": {
      "type": "string",
      "description": "Local currency code"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "mpesa",
        "mtn_mobile_money",
        "airtel_money",
        "orange_money",
        "vodacom_mpesa",
        "tigo_pesa",
        "ecocash",
        "bank_transfer",
        "credit_card",
        "paypal",
        "waiver"
      ],
      "description": "Payment method used"
    },
    "phone_number": {
      "type": "string",
      "description": "Mobile money phone number"
    },
    "transaction_id": {
      "type": "string",
      "description": "External transaction ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "cancelled",
        "refunded",
        "pending_waiver_approval"
      ],
      "default": "pending",
      "description": "Payment status"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Date of payment"
    },
    "country": {
      "type": "string",
      "description": "Country where payment was made"
    },
    "fee_waiver": {
      "type": "boolean",
      "default": false,
      "description": "Whether fee was waived"
    },
    "waiver_request_comment": {
      "type": "string",
      "description": "Comment from author requesting a waiver"
    },
    "waiver_reason": {
      "type": "string",
      "description": "Reason for fee waiver (by admin)"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes for this payment"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description or additional details for this payment"
    }
  },
  "required": [
    "manuscript_id",
    "journal_id",
    "payment_type",
    "amount"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": [
          "admin",
          "editor"
        ]
      }
    },
    "delete": {
      "user_condition": {
        "role": [
          "admin",
          "editor"
        ]
      }
    }
  }
}