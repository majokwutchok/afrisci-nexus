{
  "name": "ArticleSubscription",
  "type": "object",
  "properties": {
    "manuscript_id": {
      "type": "string",
      "description": "ID of the manuscript being followed"
    },
    "manuscript_title": {
      "type": "string",
      "description": "Title snapshot for display"
    },
    "subscriber_email": {
      "type": "string",
      "description": "Email address to notify"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this subscription"
    }
  },
  "required": [
    "manuscript_id",
    "subscriber_email"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.subscriber_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.subscriber_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.subscriber_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}